# ── Required for YouTube search ──────────────────────────────────────────────
YOUTUBE_API_KEY=

# ── Required for MediaCMS upload ─────────────────────────────────────────────
CMS_API_URL=
CMS_USER=
CMS_PASSWORD=
CMS_TOKEN=

# ── Optional project/runtime overrides ───────────────────────────────────────
VPD_PROJECT_ROOT=
DOWNLOADS_DIR=data/downloads
VPD_FRAMES_OUTPUT_DIR=data/frames
VPD_DEBUG_OUTPUT_DIR=data/frames

# ── Optional detector thresholds/tuning ──────────────────────────────────────
VPD_MIN_FRAMES_ANALYZED=4
VPD_MAX_DISCARD_RATIO=0.65
VPD_MIN_LAYOUT_SCORE_MARGIN=0.10
# Not used by the detector. The strict search band is
# VPD_LINE_CENTER_SEARCH_BAND_RATIO; the centring tolerance is
# VPD_LINE_CENTER_MAX_DISTANCE_RATIO.
VPD_LINE_CENTER_BAND_RATIO=0.08
VPD_LINE_CENTER_SEARCH_BAND_RATIO=0.02
VPD_LINE_CENTER_MAX_DISTANCE_RATIO=0.02
VPD_LINE_MAX_SLOPE=0.05
VPD_LINE_MIN_COVERAGE_RATIO=0.20
VPD_LINE_MIN_QUALITY_SCORE=0.62
VPD_LINE_FALLBACK_MIN_QUALITY_SCORE=0.78
# Area-normalised FFT orientation dominance; seamless baseline is ~0.000 at every
# resolution. Above ~0.025 it rejects most real seams.
VPD_LINE_FFT_MIN_DOMINANCE=0.015
VPD_LINE_STRONG_COVERAGE_RATIO=0.40
VPD_LINE_MORPH_LENGTH_RATIO=0.02
VPD_LINE_ENABLE_PROFILE_GATE=false
VPD_LINE_PROFILE_MIN_COVERAGE_RATIO=0.20
VPD_LINE_PROFILE_MIN_PROMINENCE=3.0
VPD_STEREO_HIST_THRESHOLD=0.92
VPD_STEREO_SEAM_GUARD_RATIO=0.02
VPD_STEREO_MIN_VALID_HALF_RATIO=0.22
VPD_STEREO_EDGE_SIMILARITY_THRESHOLD=0.08
VPD_STEREO_MIN_SEAM_FRAMES=2
VPD_STEREO_MIN_STABILITY_RATIO=0.55
VPD_SAVE_STEREO_HALVES=true
# Dense optical-flow algorithm for the motion stage; the value set here is the one
# that runs. Measured at the 960x512 flow work resolution, one real frame pair:
#   dis 72.9 ms/pair | farneback 202.4 ms/pair | deepflow 2444.1 ms | tvl1 5963.6 ms
# DIS is the default: ~34x cheaper than DeepFlow and ~82x cheaper than TV-L1.
# Setting deepflow/tvl1 works but logs a warning with the cost.
VPD_FLOW_ALGORITHM=dis
# NOTE: both flags below are force-enabled by VPD_MOTION_ROLLOUT_PROFILE when it is
# 'robust' or 'high_accuracy' (see _resolve_motion_feature_flags), so under the
# default profile they run as true regardless of the value set here. false is the
# intended value under a 'baseline' profile. Variational refinement is a no-op on
# OpenCV builds without createVariationalRefinement.
VPD_FLOW_ENABLE_REFINEMENT=false
VPD_FLOW_ENABLE_FB_CHECK=false
VPD_FLOW_FB_THRESHOLD=1.5
# EAC-vs-cubic is decided by single-frame face-boundary continuity
# (detector/face_continuity_detection.py). Set false to decide by the
# optical-flow angular vote instead (right only 40% of the time it decides).
VPD_ENABLE_FACE_CONTINUITY=true
# Calibrated against real footage (windowed structural continuity metric).
# Real EAC measures edge 0.68-0.85, real cubic -0.02..0.10.
VPD_FACE_CONTINUITY_EAC_CONTRAST=0.30
VPD_FACE_CONTINUITY_EAC_EDGE_FLOOR=0.35
VPD_FACE_CONTINUITY_CUBIC_CONTRAST=0.20
VPD_FACE_CONTINUITY_CUBIC_EDGE_CEILING=0.25
VPD_FACE_CONTINUITY_CUBIC_EDGE_DECISIVE=0.20
VPD_FACE_CONTINUITY_MIN_FRAMES=2
# Positive equirectangular evidence (detector/equirectangular_detection.py). A
# frame counts only if all three signals pass; calibrated on real footage with
# leave-one-source-out validation.
# A: the 360° join -- the frame's last and first columns must be continuous.
#    Minimum correlation of the two columns' brightness profiles:
VPD_EQUI_JUNCTION_MIN_CORR=0.84
#    Maximum join difference relative to the median adjacent-column difference:
VPD_EQUI_JUNCTION_MAX_RATIO=11.0
#    Minimum std (grey levels) of each edge column; below it the frame is unusable:
VPD_EQUI_JUNCTION_MIN_TEXTURE=1.0
# B: stretched poles -- maximum horizontal/vertical gradient ratio, top and bottom bands:
VPD_EQUI_POLAR_MAX_ANISOTROPY=0.41
# B/C: minimum mean gradient of a band; a constant (e.g. black) band fails, not passes:
VPD_EQUI_BAND_MIN_TEXTURE=0.01
# C: mono, not stereo -- minimum gradient ratio in the middle band (poles in top-bottom stereo):
VPD_EQUI_EQUATOR_MIN_ANISOTROPY=0.27
# C: maximum similarity between the frame's two halves on either axis (stereo eyes are copies):
VPD_EQUI_MAX_HALF_SIMILARITY=0.66
# Video level: minimum fraction of usable frames passing A, B and C, and minimum usable frames:
VPD_EQUI_MIN_PASS_RATIO=0.5
VPD_EQUI_MIN_FRAMES=2
# Optional ORB+homography telemetry pass; it does not influence the EAC-vs-cubic
# decision and is not enabled by any profile.
VPD_ENABLE_GEOMETRY_EVIDENCE=false
VPD_GEOMETRY_EVIDENCE_WEIGHT=0.20
# Long-edge cap (px) for dense optical flow. Uncapped native-resolution flow on
# 4K-8K 360 sources makes the motion stage take hours; 0 disables the cap.
VPD_MOTION_MAX_WORK_RESOLUTION=960
VPD_MOTION_ROLLOUT_PROFILE=high_accuracy
VPD_FORCE_FULL_CODEC_NORMALIZATION=false
