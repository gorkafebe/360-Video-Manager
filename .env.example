# ── Required for YouTube search ──────────────────────────────────────────────
YOUTUBE_API_KEY=

# ── Required for MediaCMS upload ─────────────────────────────────────────────
CMS_API_URL=
CMS_USER=
CMS_PASSWORD=
CMS_TOKEN=

# ── Optional project/runtime overrides ───────────────────────────────────────
VPD_PROJECT_ROOT=
DOWNLOADS_DIR=data/downloads
VPD_FRAMES_OUTPUT_DIR=data/frames
VPD_DEBUG_OUTPUT_DIR=data/frames

# ── Optional detector thresholds/tuning ──────────────────────────────────────
VPD_MIN_FRAMES_ANALYZED=4
VPD_MAX_DISCARD_RATIO=0.65
VPD_MIN_LAYOUT_SCORE_MARGIN=0.10
VPD_LINE_CENTER_BAND_RATIO=0.08
VPD_LINE_CENTER_SEARCH_BAND_RATIO=0.02
VPD_LINE_CENTER_MAX_DISTANCE_RATIO=0.02
VPD_LINE_MAX_SLOPE=0.05
VPD_LINE_MIN_COVERAGE_RATIO=0.20
VPD_LINE_MIN_QUALITY_SCORE=0.62
VPD_LINE_FALLBACK_MIN_QUALITY_SCORE=0.78
VPD_STEREO_HIST_THRESHOLD=0.92
VPD_STEREO_SEAM_GUARD_RATIO=0.02
VPD_STEREO_MIN_VALID_HALF_RATIO=0.22
VPD_STEREO_EDGE_SIMILARITY_THRESHOLD=0.08
VPD_STEREO_MIN_SEAM_FRAMES=2
VPD_STEREO_MIN_STABILITY_RATIO=0.55
VPD_SAVE_STEREO_HALVES=true
VPD_FLOW_ALGORITHM=deepflow
VPD_FLOW_ENABLE_REFINEMENT=false
VPD_FLOW_ENABLE_FB_CHECK=false
VPD_FLOW_FB_THRESHOLD=1.5
VPD_ENABLE_GEOMETRY_EVIDENCE=false
VPD_GEOMETRY_EVIDENCE_WEIGHT=0.20
VPD_MOTION_ROLLOUT_PROFILE=high_accuracy
VPD_FORCE_FULL_CODEC_NORMALIZATION=false
