# ── Credentials & secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Runtime data (generated at runtime) ──────────────────────────────────────
# Downloads, frames, jobs, logs and tmp — created by Settings.ensure_runtime_dirs().
data/

# ── Python artefacts ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Distribution / packaging ─────────────────────────────────────────────────
# build/ and dist/ are PyInstaller output (see packaging/README_build.md).
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
# A virtualenv created directly in the project root (anchored so they cannot
# match a source directory such as detector/lib/).
/bin/
/lib/
/lib64
/share/
/include/
/pyvenv.cfg
.python-version

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log

# ── IDEs & editors ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Downloaded / generated media (large binary files) ────────────────────────
*.mp4
*.mkv
*.webm
*.avi
*.mov
*.ts
*.jpg
*.jpeg
*.png
*.bmp
*.gif
*.zip
*.tar.gz
*.tar
*.rar
# Exception: the application icon assets generated by packaging/icon_generator.py.
!packaging/icon*.png
